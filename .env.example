# Copy to .env for local dev. Never commit real keys.
# On Render, set these in the service's Environment tab instead.
PORT=3001
# Used from Phase 4 (content pipeline) and Phase 7 (AI players):
ANTHROPIC_API_KEY=
# AI players (Phase 7). Without a key, AI players use a built-in simulation.
# Model used by AI players. Default: claude-opus-5-5. claude-haiku-5-5 is much cheaper and faster.
AI_MODEL=
# Cost guard: max Claude calls per game (guesses + drawings). Default 150.
AI_MAX_CALLS_PER_GAME=
